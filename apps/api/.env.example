# ═══════════════════════════════════════════════════════════════════════════
# Manakō API — Variables de entorno (copiar a .env y completar)
# Guía completa de obtención de claves: docs/SETUP.md
# ═══════════════════════════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Orígenes permitidos (CORS whitelist), separados por coma
CORS_ORIGINS=http://localhost:4200
# URL pública del frontend (para redirects de Stripe Checkout)
FRONTEND_URL=http://localhost:4200

# ── Base de datos (Supabase → Project Settings → Database → Connection string)
# En producción usar el pooler (PgBouncer, puerto 6543) + SSL:
DATABASE_URL="postgresql://postgres.TU-REF:TU_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (no-pooler, puerto 5432) usada por Prisma Migrate:
DIRECT_URL="postgresql://postgres.TU-REF:TU_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (validación de JWT en la API) ────────────────────────────
SUPABASE_URL=https://TU-REF.supabase.co
# Clave service_role (SOLO en el backend, NUNCA en el cliente):
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Verificación de JWT: o bien el secreto simétrico (HS256, legacy)...
SUPABASE_JWT_SECRET=tu-jwt-secret
# ...o la URL JWKS para claves asimétricas (nuevo estándar de Supabase):
# SUPABASE_JWKS_URL=https://TU-REF.supabase.co/auth/v1/.well-known/jwks.json
# Issuer esperado en el JWT (normalmente <SUPABASE_URL>/auth/v1):
SUPABASE_JWT_ISSUER=https://TU-REF.supabase.co/auth/v1

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# (Fase 3, marketplace) plataforma: comisión en % sobre cada venta
PLATFORM_FEE_PERCENT=30

# ── Proveedor de video: mux | cloudflare | direct ───────────────────────────
VIDEO_PROVIDER=direct
# Duración (segundos) de las URLs firmadas de reproducción
PLAYBACK_URL_TTL_SECONDS=600
# Umbral de completado de lección (spec §4): watched >= duration * umbral
PROGRESS_COMPLETION_THRESHOLD=0.9

# Mux (https://mux.com → Settings → API tokens / Signing keys)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Cloudflare Stream (dash.cloudflare.com → Stream)
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_KEY=
CF_STREAM_PRIVATE_KEY_PEM=
CF_STREAM_WEBHOOK_SECRET=

# ── Redis (opcional en MVP: cache de catálogo/flags; requerido para BullMQ) ──
REDIS_URL=redis://localhost:6379

# ── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_FORMAT=json
