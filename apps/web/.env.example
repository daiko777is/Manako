# ═══════════════════════════════════════════════════════════════════════════
# Manakō Web — Variables de entorno (copiar a .env y completar)
# Al ejecutar `npm start` / `npm build`, el script scripts/env-to-environment.mjs
# genera src/environments/environment*.ts automáticamente desde este .env.
# Guía completa: docs/SETUP.md
# ═══════════════════════════════════════════════════════════════════════════

# URL base de la API NestJS (incluye /api/v1)
NG_APP_API_URL=http://localhost:3000/api/v1

# Supabase → Project Settings → API
NG_APP_SUPABASE_URL=https://TU-REF.supabase.co
# anon PUBLIC key (segura en el cliente: RLS protege los datos)
NG_APP_SUPABASE_ANON_KEY=tu-anon-public-key
